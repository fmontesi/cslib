module

public import Cslib.Foundations.Concurrency.RoundRobin.Queue
public import Cslib.Foundations.Concurrency.Linearisation

/-!
# The round-robin scheduler

This module constructs the finite linearisation that witnesses the existence part of the
extraction theorem for smurf LTSs.  A scheduler state pairs an original state with a *queue*: a
permutation of a finite alphabet of labels covering every label used by the system.  At each
step the first enabled label of the queue is *selected*; the scheduler may then execute either
the selected label or one of its matching partners; and the queue is rotated so that the
selected label ends up at the back, preceded by the disabled prefix that was skipped.

Because the rotation is always computed from the selected label, even when a matching partner is
executed, the position in the queue of any label independent of the executed one strictly
decreases.  Iterating gives a bound of the form `length w + rank λ q' ≤ rank λ q` along every
multistep transition whose labels are independent of `λ`, which rules out nonempty cycles. The
resulting LTS is therefore a linearisation of the original one, and it is finite whenever the
original state type is.

## Main definitions

- `enabledAt` is the classical enabledness decision used by the selection.
- `scheduler` is the round-robin LTS over `State × Queue alphabet`.

## Main statements

- `scheduler_isLinear`: the scheduler is linear.
- `scheduler_rank_decrease` and `scheduler_rank_bound`: the rank of an independent enabled label
  strictly decreases at every step, and the trace length plus the rank is non-increasing.
- `scheduler_cycle`: nonempty scheduler cycles contain a label that is not independent of any
  label enabled at the start, which is the cycle condition of a linearisation.
- `scheduler_isLinearisation`: the scheduler is a linearisation of the original LTS.

## Implementation notes

The enabledness decision is classical, so the construction is an existence proof: no computable
extractor is claimed, and the construction does not prove that the paper's greedy algorithm
terminates.
-/

@[expose] public section

namespace Cslib.Concurrency.RoundRobin

open Cslib

universe u v

variable {State : Type u} {Label : Type v}

/-! ### Classical enabledness -/

open Classical in
/-- Classical enabledness decision: `true` iff `A` has a `b`-transition out of `s`. -/
noncomputable def enabledAt (A : LTS State Label) (s : State) (b : Label) : Bool :=
  if ∃ t, A.Tr s b t then true else false

/-- The enabledness decision accepts exactly the enabled labels. -/
theorem enabledAt_true_iff (A : LTS State Label) (s : State) (b : Label) :
    enabledAt A s b = true ↔ ∃ t, A.Tr s b t := by
  by_cases h : ∃ t, A.Tr s b t <;> simp [enabledAt, h]

/-- The enabledness decision rejects exactly the disabled labels. -/
theorem enabledAt_false_iff (A : LTS State Label) (s : State) (b : Label) :
    enabledAt A s b = false ↔ ¬ ∃ t, A.Tr s b t := by
  by_cases h : ∃ t, A.Tr s b t <;> simp [enabledAt, h]

variable {B : Branching Label}

/-! ### The scheduler -/

/-- The round-robin scheduler generated by an LTS and a finite alphabet.  A state is an original
state together with a queue, i.e. a permutation of the alphabet. -/
noncomputable def scheduler (A : LTS State Label) (alphabet : List Label) :
    LTS (State × Queue alphabet) Label where
  Tr sq μ sq' :=
    ∃ (t : State) (p r : List Label) (a : Label) (h : sq.2.val = p ++ a :: r),
      Queue.select? (enabledAt A sq.1) sq.2.val = some (p, a, r) ∧
      sq' = (t, Queue.rotateQueue sq.2 p r a h) ∧
      A.Tr sq.1 μ t ∧ (μ = a ∨ B.matching a μ)

/-- Introduction rule for scheduler transitions, from an explicit selection at `s`. -/
theorem scheduler_tr_of_select {A : LTS State Label} {alphabet : List Label}
    {s t : State} {q q' : Queue alphabet} {μ a : Label} {p r : List Label}
    (hval : q.val = p ++ a :: r)
    (hsel : Queue.select? (enabledAt A s) q.val = some (p, a, r))
    (hq' : q' = Queue.rotateQueue q p r a hval)
    (htr : A.Tr s μ t) (hμ : μ = a ∨ B.matching a μ) :
    (scheduler (B := B) A alphabet).Tr (s, q) μ (t, q') := by
  refine ⟨t, p, r, a, hval, hsel, ?_, htr, hμ⟩
  rw [hq']

/-- Any two transitions out of the same scheduler state select the same label: the first-enabled
decomposition of a queue is unique. -/
private theorem scheduler_tr_same_selected {A : LTS State Label} {alphabet : List Label}
    {s s₁ s₂ : State} {q q₁ q₂ : Queue alphabet} {μ₁ μ₂ : Label}
    (h₁ : (scheduler (B := B) A alphabet).Tr (s, q) μ₁ (s₁, q₁))
    (h₂ : (scheduler (B := B) A alphabet).Tr (s, q) μ₂ (s₂, q₂)) :
    ∃ a : Label, (μ₁ = a ∨ B.matching a μ₁) ∧ (μ₂ = a ∨ B.matching a μ₂) := by
  obtain ⟨-, p₁, r₁, a₁, -, hsel₁, -, -, hμ₁⟩ := h₁
  obtain ⟨-, p₂, r₂, a₂, -, hsel₂, -, -, hμ₂⟩ := h₂
  obtain ⟨-, rfl, -⟩ := Queue.select?_unique _ hsel₁ hsel₂
  exact ⟨a₁, hμ₁, hμ₂⟩

/-! ### Coverage of the alphabet

If the alphabet covers every label occurring in a transition, then every nonterminal state
selects a label. -/

/-- Coverage of the alphabet yields a first-enabled decomposition at every nonterminal state. -/
theorem select?_isSome_of_nonterminal {A : LTS State Label} {alphabet : List Label}
    (hΛ : ∀ s a t, A.Tr s a t → a ∈ alphabet) {s : State} {q : Queue alphabet}
    (h : ∃ μ t, A.Tr s μ t) :
    ∃ p a r, Queue.select? (enabledAt A s) q.val = some (p, a, r) := by
  obtain ⟨μ, t, htr⟩ := h
  have hmem : μ ∈ q.val := (Queue.perm q).mem_iff.mpr (hΛ s μ t htr)
  have hen : enabledAt A s μ = true := (enabledAt_true_iff A s μ).mpr ⟨t, htr⟩
  exact Queue.select?_eq_some_of_mem _ hmem hen

/-- Every nonterminal state of the scheduler has an outgoing transition. -/
theorem scheduler_exists_tr_of_not_terminal {A : LTS State Label} {alphabet : List Label}
    (hΛ : ∀ s a t, A.Tr s a t → a ∈ alphabet) {s : State} {q : Queue alphabet}
    (h : ∃ μ t, A.Tr s μ t) :
    ∃ μ sq', (scheduler (B := B) A alphabet).Tr (s, q) μ sq' := by
  obtain ⟨p, a, r, hsel⟩ := select?_isSome_of_nonterminal hΛ h
  obtain ⟨hval, hen, -⟩ := Queue.select?_eq_some_spec _ hsel
  obtain ⟨t, htr⟩ := (enabledAt_true_iff A s a).mp hen
  exact ⟨a, (t, Queue.rotateQueue q p r a hval),
    scheduler_tr_of_select hval hsel rfl htr (Or.inl rfl)⟩

/-- Terminal states of the scheduler map to terminal states of the original system. -/
theorem scheduler_isTerminal {A : LTS State Label} {alphabet : List Label}
    (hΛ : ∀ s a t, A.Tr s a t → a ∈ alphabet) {s : State} {q : Queue alphabet} :
    (scheduler (B := B) A alphabet).IsTerminal (s, q) → A.IsTerminal s := by
  intro hterm μ t htr
  obtain ⟨μ', sq', hsq'⟩ :=
    scheduler_exists_tr_of_not_terminal (B := B) hΛ ⟨μ, t, htr⟩
  exact hterm μ' sq' hsq'

/-! ### Mapping transitions back to the original system -/

/-- A scheduler transition maps onto an original transition between the same states. -/
theorem scheduler_tr_snd_state {A : LTS State Label} {alphabet : List Label}
    {s t : State} {q q' : Queue alphabet} {μ : Label}
    (htr : (scheduler (B := B) A alphabet).Tr (s, q) μ (t, q')) : A.Tr s μ t := by
  obtain ⟨t₀, p, r, a, hval, -, hq', htrA, -⟩ := htr
  simp only [Prod.mk.injEq] at hq'
  obtain ⟨rfl, -⟩ := hq'
  simpa using htrA

/-- The executed label is enabled at the original state, by construction. -/
theorem scheduler_tr_original {A : LTS State Label} {alphabet : List Label}
    {s t : State} {q q' : Queue alphabet} {μ : Label}
    (htr : (scheduler (B := B) A alphabet).Tr (s, q) μ (t, q')) : ∃ t', A.Tr s μ t' :=
  ⟨t, scheduler_tr_snd_state htr⟩

/-! ### Linearity -/

/-- The scheduler is linear: every conditional label has an enabled matching partner, and any
two distinct enabled labels match. -/
theorem scheduler_isLinear {A : LTS State Label} {alphabet : List Label}
    {I : Label → Label → Prop} [Independence I]
    (hsmurf : Smurf A I B) :
    IsLinear (B := B) (scheduler (B := B) A alphabet) := by
  constructor
  · rintro ⟨s, q⟩ μ₁ ⟨s₁, q₁⟩ htr₁
    obtain ⟨t₁, p, r, a, hval, hsel, hq', htrA, hμ⟩ := htr₁
    by_cases hcond : B.conditional μ₁
    · rcases hμ with hμ_eq | hμ_match
      · -- the selected label is the conditional one, so use its matching partner
        have hconda : B.conditional a := hμ_eq ▸ hcond
        have htra : A.Tr s a t₁ := hμ_eq ▸ htrA
        obtain ⟨l₂, s₂, hmatch₂, htr₂⟩ := hsmurf.m s t₁ a ⟨hconda, htra⟩
        refine Or.inr ⟨l₂, (s₂, Queue.rotateQueue q p r a hval), ?_, ?_⟩
        · exact scheduler_tr_of_select hval hsel rfl htr₂ (Or.inr hmatch₂)
        · exact hμ_eq ▸ hmatch₂
      · -- a matching partner is executed, so the selected label is its partner
        obtain ⟨t, htr⟩ := (enabledAt_true_iff A s a).mp (Queue.select?_eq_some_spec _ hsel).2.1
        refine Or.inr ⟨a, (t, Queue.rotateQueue q p r a hval), ?_, ?_⟩
        · exact scheduler_tr_of_select hval hsel rfl htr (Or.inl rfl)
        · exact Std.Symm.symm a μ₁ hμ_match
    · exact Or.inl hcond
  · rintro ⟨s, q⟩ μ₁ μ₂ ⟨s₁, q₁⟩ ⟨s₂, q₂⟩ ⟨htr₁, htr₂, hne⟩
    obtain ⟨a, hμ₁, hμ₂⟩ := scheduler_tr_same_selected htr₁ htr₂
    rcases hμ₁ with h₁ | hm₁
    · rcases hμ₂ with h₂ | hm₂
      · exact absurd (h₁.trans h₂.symm) hne
      · rw [h₁]
        exact hm₂
    · rcases hμ₂ with h₂ | hm₂
      · rw [h₂]
        exact Std.Symm.symm a μ₁ hm₁
      · exact absurd (B.functional a μ₁ μ₂ hm₁ hm₂) hne

/-! ### The central rank lemma -/

/-- Ranks of independent labels strictly decrease along scheduler transitions.  The selected
label is the only label whose rank can fail to decrease, because the rotation is always computed
from the selected label, even when a matching partner is executed.

The coverage hypothesis is needed so that the measured label occurs in the queue. -/
theorem scheduler_rank_decrease {A : LTS State Label} {alphabet : List Label}
    {I : Label → Label → Prop} [Independence I]
    (hsmurf : Smurf A I B) (hno : ∀ a b, B.matching a b → ¬ I a b)
    (hΛ : ∀ s a t, A.Tr s a t → a ∈ alphabet)
    {s t : State} {q q' : Queue alphabet} {μ lam : Label}
    (hen : ∃ s', A.Tr s lam s')
    (htr : (scheduler (B := B) A alphabet).Tr (s, q) μ (t, q')) (hI : I lam μ) :
    (∃ t', A.Tr t lam t') ∧ Queue.rank lam q'.val < Queue.rank lam q.val := by
  obtain ⟨t₀, p, r, a, hval, hsel, hq', htrA, hμ⟩ := htr
  -- the measured label occurs in the queue and is enabled
  obtain ⟨s', htrlam⟩ := hen
  have hmem : lam ∈ q.val := (Queue.perm q).mem_iff.mpr (hΛ s lam s' htrlam)
  have henlam : enabledAt A s lam = true := (enabledAt_true_iff A s lam).mpr ⟨s', htrlam⟩
  -- and it differs from the selected label, on both branches
  have hne : a ≠ lam := by
    intro hcon
    rcases hμ with hμ_eq | hμ_match
    · rw [hμ_eq, hcon] at hI
      exact Std.Irrefl.irrefl lam hI
    · exact hno lam μ (hcon ▸ hμ_match) hI
  -- so it lies in the suffix, where its rank strictly decreases
  obtain ⟨rfl, hq⟩ := Prod.mk.inj hq'
  obtain ⟨s₃, -, htrlam'⟩ := hsmurf.f s s' _ lam μ ⟨hI, htrlam, htrA⟩
  refine ⟨⟨s₃, htrlam'⟩, ?_⟩
  rw [hq, Queue.rotateQueue_val]
  exact Queue.rank_lt_of_select hsel hmem henlam hne

/-! ### Multistep bound and the cycle condition -/

/-- Along a multistep transition whose labels are all independent of an enabled label, the sum
of the trace length and the label's rank cannot exceed the initial rank. -/
theorem scheduler_rank_bound {A : LTS State Label} {alphabet : List Label}
    {I : Label → Label → Prop} [Independence I]
    (hsmurf : Smurf A I B) (hno : ∀ a b, B.matching a b → ¬ I a b)
    (hΛ : ∀ s a t, A.Tr s a t → a ∈ alphabet)
    {s t : State} {q q' : Queue alphabet} {w : List Label} {lam : Label}
    (hen : ∃ s', A.Tr s lam s')
    (hw : (scheduler (B := B) A alphabet).MTr (s, q) w (t, q'))
    (hind : ∀ μ ∈ w, I lam μ) :
    (∃ t', A.Tr t lam t') ∧ w.length + Queue.rank lam q'.val ≤ Queue.rank lam q.val := by
  induction w generalizing s t q q' with
  | nil =>
      have hsq : (s, q) = (t, q') := LTS.MTr.nil_eq (scheduler (B := B) A alphabet) hw
      simp only [Prod.mk.injEq] at hsq
      obtain ⟨rfl, rfl⟩ := hsq
      exact ⟨hen, by simp⟩
  | cons μ w ih =>
      obtain ⟨⟨s₁, q₁⟩, htr, hmtr⟩ := LTS.MTr.cons_iff.mp hw
      have hI : I lam μ := hind μ List.mem_cons_self
      have hind' : ∀ μ' ∈ w, I lam μ' := fun μ' hμ' => hind μ' (List.mem_cons_of_mem μ hμ')
      obtain ⟨hen₁, hrank₁⟩ := scheduler_rank_decrease hsmurf hno hΛ hen htr hI
      obtain ⟨hen₂, hrank₂⟩ := ih hen₁ hmtr hind'
      refine ⟨hen₂, ?_⟩
      simp only [List.length_cons]
      omega

/-- On a nonempty scheduler cycle, every label enabled at the start is not independent of some
label of the cycle.  Otherwise its rank would have to decrease strictly around the cycle. -/
theorem scheduler_cycle {A : LTS State Label} {alphabet : List Label}
    {I : Label → Label → Prop} [Independence I]
    (hsmurf : Smurf A I B) (hno : ∀ a b, B.matching a b → ¬ I a b)
    (hΛ : ∀ s a t, A.Tr s a t → a ∈ alphabet)
    {s : State} {q : Queue alphabet} {w : List Label} (hne : w ≠ [])
    (hw : (scheduler (B := B) A alphabet).MTr (s, q) w (s, q)) :
    ∀ μ t, A.Tr s μ t → ∃ μ' ∈ w, ¬ I μ μ' := by
  intro μ t htr
  by_contra hcon
  simp only [not_exists, not_and, not_not] at hcon
  have hen : ∃ t', A.Tr s μ t' := ⟨t, htr⟩
  have hind : ∀ μ' ∈ w, I μ μ' := fun μ' hμ' => hcon μ' hμ'
  obtain ⟨-, hbound⟩ := scheduler_rank_bound hsmurf hno hΛ hen hw hind
  have hlen : w.length = 0 := by omega
  exact hne (List.eq_nil_of_length_eq_zero hlen)

/-! ### The assembled linearisation -/

/-- The round-robin scheduler is a linearisation of the original system, mapping every
scheduler state to its original component and starting from the queue given by the alphabet. -/
theorem scheduler_isLinearisation {A : LTS State Label} {alphabet : List Label}
    {I : Label → Label → Prop} [Independence I]
    (hsmurf : Smurf A I B) (hno : ∀ a b, B.matching a b → ¬ I a b)
    (hΛ : ∀ s a t, A.Tr s a t → a ∈ alphabet) (s₀ : State) :
    IsLinearisation (B := B) (I := I) (scheduler (B := B) A alphabet) A
      (s₀, Queue.initial alphabet) s₀ Prod.fst := by
  refine ⟨scheduler_isLinear hsmurf, rfl, ?_, ?_, ?_⟩
  · rintro ⟨s, q⟩ μ ⟨s', q'⟩ htr
    exact scheduler_tr_snd_state htr
  · rintro ⟨s, q⟩ hterm
    exact scheduler_isTerminal hΛ hterm
  · rintro ⟨s, q⟩ w hne hw μ s' htr
    exact scheduler_cycle hsmurf hno hΛ hne hw μ s' htr

/-! ### Finiteness -/

/-- The scheduler state space is finite whenever the original one is. -/
instance finiteSchedulerState [Finite State] : Finite (State × Queue alphabet) := inferInstance

end Cslib.Concurrency.RoundRobin
